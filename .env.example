# Copy to .env and fill in. Every variable is validated at startup (src/config/env.ts).

NODE_ENV=development
PORT=4000

# Supabase session pooler connection string (Project → Connect → Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000
# Frontend URL used in email links
APP_URL=http://localhost:3000

# Refresh cookie. Defaults suit localhost. In production serve the API from api.<your-domain>,
# set COOKIE_DOMAIN=.<your-domain> and keep SameSite=lax.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Gmail SMTP (needs 2-Step Verification + an App Password). Empty in dev = emails print to the console.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# EMAIL_FROM="FAA Platform <you@gmail.com>"

# LOG_LEVEL=info
# LOG_PRETTY=true
# ENABLE_DOCS=false
